{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nodemon --watch index.js --watch src --ext js,json index.js",
    "test": "node --test test/*.test.js",
    "test:deploy": "node scripts/deploy-smoke-test.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:prepare:question-bank": "npm run db:import:question-bank -- --apply --require-render && npm run db:repair-question-bank-rw-graphs -- --apply --require-render && npm run db:repair-question-bank-math-graphs -- --apply --require-render && npm run db:publish-question-bank -- --apply --require-render && npm run db:audit-question-bank-images -- --require-render",
    "db:import:question-bank": "node scripts/import-question-bank-production.js",
    "db:repair-question-bank-rw-graphs": "node scripts/repair-question-bank-rw-graphs.js",
    "db:repair-question-bank-math-graphs": "node scripts/repair-question-bank-math-graphs.js",
    "db:audit-question-bank-images": "node scripts/audit-question-bank-images.js",
    "db:publish-question-bank": "node scripts/publish-system-question-bank.js",
    "data:build-question-bank-rw-graphs": "node scripts/build-question-bank-rw-graph-bundle.js",
    "data:build-question-bank-math-graphs": "node scripts/build-question-bank-math-graph-bundle.js",
    "db:seed:vocabulary": "node prisma/seed-vocabulary.js",
    "db:seed:teacher-overview": "node scripts/seed-teacher-overview.js",
    "storage:cleanup": "node scripts/cleanup-file-assets.js",
    "storage:backfill-test-images": "node scripts/backfill-test-images.js",
    "storage:backfill-question-bank-images": "node scripts/backfill-question-bank-images.js",
    "storage:smoke": "node scripts/storage-smoke-test.js",
    "admin:create": "node scripts/admin-cli.js create",
    "admin:promote": "node scripts/admin-cli.js promote",
    "admin:rotate-password": "node scripts/admin-cli.js rotate-password",
    "admin:revoke-sessions": "node scripts/admin-cli.js revoke-sessions",
    "admin:demote": "node scripts/admin-cli.js demote",
    "start": "node index.js",
    "start:render": "prisma migrate deploy && npm start",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@google/genai": "^1.44.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.75.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.47",
    "mammoth": "^1.11.0",
    "multer": "^2.1.1",
    "pdf-extraction": "^1.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.17.7",
    "stream": "^0.0.3",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.15.0",
