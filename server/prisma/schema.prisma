generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dictionary data is shared across users, separate from personal Vocabulary progress.
model DictionaryCache {
  language  String   @default("en") @db.VarChar(8)
  word      String   @db.VarChar(64)
  found     Boolean
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@id([language, word])
  @@index([expiresAt])
}

model User {
  id                         Int                           @id @default(autoincrement())
  email                      String                        @unique
  googleSubject              String?                       @unique
  password                   String?
  createdAt                  DateTime                      @default(now())
  name                       String?
  role                       Role                          @default(STUDENT)
  avatar                     String?
  satTestDate                DateTime?
  currentSatScore            Int?
  targetSatScore             Int?
  dashboardBackground        String?
  taughtClasses              Class[]                       @relation("TeacherClasses")
  errorLogs                  ErrorLog[]
  homeworkSubmissions        HomeworkSubmission[]
  submissions                Submission[]
  createdTests               Test[]
  studyingClasses            Class[]                       @relation("StudentClasses")
  notifications              Notification[]
  SubFolders                 Folder[]
  createdDeliveries          TestDelivery[]                @relation("DeliveryCreator")
  deliveryAssignments        DeliveryAssignee[]
  todoStates                 UserTodoState[]
  studentTasks               StudentTask[]
  refreshSessions            RefreshSession[]
  ownedVocabularySets        VocabularySet[]               @relation("VocabularySetOwner")
  createdVocabularySets      VocabularySet[]               @relation("VocabularySetCreator")
  vocabularyProgress         VocabularyTermProgress[]
  vocabularySessions         VocabularyStudySession[]
  createdActivities          ClassActivity[]               @relation("ActivityCreator")
  createdAnnouncements       ClassAnnouncement[]           @relation("AnnouncementAuthor")
  activityAssignments        ActivityAssignee[]
  lessonProgress             LessonProgress[]
  resourceProgress           ResourceProgress[]
  auditEvents                AuditEvent[]                  @relation("AuditEventActor")
  fileAssets                 FileAsset[]                   @relation("FileAssetOwner")
  studySessions              StudySession[]
  createdLearningFollowUps   LearningFollowUp[]            @relation("LearningFollowUpCreator")
  learningFollowUpTargets    LearningFollowUpTarget[]      @relation("LearningFollowUpTargetStudent")
  recordedAttendanceSessions AttendanceSession[]           @relation("AttendanceRecorder")
  attendanceRecords          AttendanceRecord[]            @relation("AttendanceStudent")
  lessonBlockProgress        LessonBlockProgress[]         @relation("LessonBlockProgressStudent")
  ownedBankQuestions         QuestionBankItem[]            @relation("QuestionBankOwner")
  createdBankVersions        QuestionBankVersion[]         @relation("QuestionBankVersionCreator")
  bankQuestionProgress       StudentBankQuestionProgress[]
  bankQuestionAttempts       BankQuestionAttempt[]
  createdRoadmaps            Roadmap[]                     @relation("RoadmapCreator")
  roadmapProgress            StudentMilestoneProgress[]
  teacherAccessRequest       TeacherAccessRequest?         @relation("TeacherAccessApplicant")
  reviewedTeacherRequests    TeacherAccessRequest[]        @relation("TeacherAccessReviewer")
  feedback                   Feedback[]                    @relation("FeedbackAuthor")
  reviewedFeedback           Feedback[]                    @relation("FeedbackReviewer")
}

enum FeedbackLevel {
  CRITICAL
  MAJOR
  MINOR
  IMPROVEMENT
  GENERAL
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Feedback {
  id           String         @id @default(uuid())
  userId       Int
  level        FeedbackLevel
  message      String         @db.VarChar(5000)
  pagePath     String?        @db.VarChar(500)
  status       FeedbackStatus @default(NEW)
  reviewedById Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?          @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments  FeedbackAttachment[]

  @@index([status, createdAt, id])
  @@index([level, createdAt, id])
  @@index([createdAt, id])
  @@index([userId, createdAt])
}

model FeedbackAttachment {
  feedbackId  String
  fileAssetId String    @unique
  feedback    Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  asset       FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@id([feedbackId, fileAssetId])
}

enum TeacherAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeacherAccessRequest {
  id           String              @id @default(uuid())
  userId       Int                 @unique
  reason       String              @db.VarChar(1000)
  status       TeacherAccessStatus @default(PENDING)
  reviewNote   String?             @db.VarChar(1000)
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation("TeacherAccessApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("TeacherAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt, id])
}

model RefreshSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Class {
  id                String              @id @default(uuid())
  name              String
  color             String              @default("#1B7A5A")
  createdAt         DateTime            @default(now())
  teacherId         Int
  assignments       Assignment[]
  teacher           User                @relation("TeacherClasses", fields: [teacherId], references: [id])
  classTests        ClassTest[]
  students          User[]              @relation("StudentClasses")
  weeks             Week[]
  deliveries        TestDelivery[]
  activities        ClassActivity[]
  announcements     ClassAnnouncement[]
  learningFollowUps LearningFollowUp[]

  @@index([teacherId, createdAt])
}

model Assignment {
  id               String               @id @default(uuid())
  title            String
  type             String               @default("assignment")
  content          String?
  fileUrls         String[]
  links            String[]
  testIds          Int[]                @default([])
  deadline         DateTime?
  maxPoints        Float?
  createdAt        DateTime             @default(now())
  classId          String
  class            Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions      HomeworkSubmission[]
  testSubmissions  Submission[]
  activity         HomeworkActivity?
  lessonAssignment LessonAssignment?

  @@index([classId, createdAt])
}

model ClassAnnouncement {
  id        String   @id @default(uuid())
  classId   String
  authorId  Int
  title     String
  content   String?
  fileUrls  String[]
  links     String[]
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@index([classId, isPinned, createdAt])
  @@index([authorId, createdAt])
}

model HomeworkSubmission {
  id           String                      @id @default(uuid())
  fileUrl      String?
  textResponse String?
  score        Float?
  feedback     String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  updatedAt    DateTime                    @updatedAt
  status       String                      @default("SUBMITTED")
  studentId    Int
  assignmentId String
  assignment   Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User                        @relation(fields: [studentId], references: [id])
  contents     HomeworkSubmissionContent[]

  @@unique([studentId, assignmentId])
  @@index([assignmentId, status, submittedAt])
}

model HomeworkSubmissionContent {
  id           String                   @id @default(uuid())
  submissionId String
  slot         SubmissionContentSlot
  textResponse String?
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  submission   HomeworkSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  items        HomeworkSubmissionItem[]

  @@unique([submissionId, slot])
  @@index([submissionId, updatedAt])
}

model HomeworkSubmissionItem {
  id          String                    @id @default(uuid())
  contentId   String
  kind        SubmissionItemKind
  fileAssetId String?
  externalUrl String?
  displayName String?
  order       Int                       @default(0)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  content     HomeworkSubmissionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset?                @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([contentId, order])
  @@index([fileAssetId])
}

model FileAsset {
  id            String                   @id @default(uuid())
  ownerId       Int
  provider      String
  storageKey    String                   @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  status        FileAssetStatus          @default(PENDING_UPLOAD)
  purpose       FileAssetPurpose         @default(GENERAL)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  owner         User                     @relation("FileAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items         HomeworkSubmissionItem[]
  lessonFile    LessonFile?
  testImages    TestImageUsage[]
  bankQuestions QuestionBankImageUsage[]
  feedbackAttachment FeedbackAttachment?

  @@index([ownerId, status, createdAt])
  @@index([status, createdAt])
}

model TestImageUsage {
  testId      Int
  fileAssetId String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  asset       FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@id([testId, fileAssetId])
  @@index([fileAssetId])
}

model QuestionBankImageUsage {
  questionId  String
  fileAssetId String
  question    QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  asset       FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@id([questionId, fileAssetId])
  @@index([fileAssetId])
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  userId    Int // Của giáo viên nào
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ tự trỏ (Folder con nằm trong Folder cha)
  parentId Int?
  parent   Folder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("SubFolders")

  // Quan hệ với Test
  tests Test[]
}

model Test {
  id             Int              @id @default(autoincrement())
  description    String?
  duration       Int              @default(64)
  title          String
  mode           TestMode         @default(PRACTICE)
  authorId       Int?
  category       TestCategory     @default(PRACTICE)
  isPublic       Boolean          @default(false)
  subject        TestSubject      @default(RW)
  status         TestStatus       @default(DRAFT)
  scope          TestScope        @default(PERSONAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  testDate       String?
  isDiscoverable Boolean          @default(true)
  classTests     ClassTest[]
  sections       Section[]
  submissions    Submission[]
  folderId       Int?
  folder         Folder?          @relation(fields: [folderId], references: [id], onDelete: Cascade)
  author         User?            @relation(fields: [authorId], references: [id])
  deliveries     TestDelivery[]
  images         TestImageUsage[]

  @@index([authorId, status, updatedAt])
  @@index([scope, status, updatedAt])
  @@index([isPublic, status, updatedAt])
}

model ClassTest {
  id         Int       @id @default(autoincrement())
  classId    String
  testId     Int
  assignedAt DateTime  @default(now())
  dueDate    DateTime?
  isHidden   Boolean   @default(false)
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  test       Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  submissions Submission[]

  @@unique([classId, testId])
}

model Section {
  id        Int        @id @default(autoincrement())
  testId    Int
  name      String
  order     Int
  duration  Int
  questions Question[]
  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Question {
  id                   Int                  @id @default(autoincrement())
  sectionId            Int
  type                 QuestionType         @default(MCQ)
  choices              Json
  correctAnswer        String
  blocks               Json
  questionText         String
  explanation          String?
  order                Int                  @default(0)
  domainCode           String?
  skillCode            String?
  sourceBankQuestionId String?
  sourceBankVersionId  String?
  answers              Answer[]
  section              Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  domain               QuestionDomain?      @relation("QuestionDomainQuestions", fields: [domainCode], references: [code], onDelete: SetNull)
  skill                QuestionSkill?       @relation("QuestionSkillQuestions", fields: [skillCode], references: [code], onDelete: SetNull)
  sourceBankQuestion   QuestionBankItem?    @relation("QuestionBankSnapshots", fields: [sourceBankQuestionId], references: [id], onDelete: SetNull)
  sourceBankVersion    QuestionBankVersion? @relation("QuestionBankVersionSnapshots", fields: [sourceBankVersionId], references: [id], onDelete: SetNull)
  timings              QuestionTiming[]
  errorLogs            ErrorLog[]

  @@index([domainCode])
  @@index([skillCode])
  @@index([sourceBankQuestionId])
  @@index([sourceBankVersionId])
}

model QuestionDomain {
  code          String             @id
  name          String
  subject       TestSubject
  sortOrder     Int
  skills        QuestionSkill[]
  questions     Question[]         @relation("QuestionDomainQuestions")
  bankQuestions QuestionBankItem[] @relation("BankQuestionDomainQuestions")

  @@index([subject, sortOrder])
}

model QuestionSkill {
  code              String             @id
  name              String
  domainCode        String
  sortOrder         Int
  domain            QuestionDomain     @relation(fields: [domainCode], references: [code], onDelete: Cascade)
  questions         Question[]         @relation("QuestionSkillQuestions")
  bankQuestions     QuestionBankItem[] @relation("BankQuestionSkillQuestions")
  roadmapMilestones MilestoneSkill[]

  @@index([domainCode, sortOrder])
}

model QuestionBankItem {
  id         String                        @id @default(uuid())
  ownerId    Int
  scope      QuestionBankScope
  status     QuestionBankStatus            @default(DRAFT)
  subject    TestSubject
  type       QuestionType                  @default(MCQ)
  difficulty QuestionBankDifficulty        @default(MEDIUM)
  domainCode String
  skillCode  String
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  owner      User                          @relation("QuestionBankOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  domain     QuestionDomain                @relation("BankQuestionDomainQuestions", fields: [domainCode], references: [code], onDelete: Restrict)
  skill      QuestionSkill                 @relation("BankQuestionSkillQuestions", fields: [skillCode], references: [code], onDelete: Restrict)
  versions   QuestionBankVersion[]
  snapshots  Question[]                    @relation("QuestionBankSnapshots")
  progress   StudentBankQuestionProgress[]
  attempts   BankQuestionAttempt[]
  images     QuestionBankImageUsage[]

  @@index([scope, status, subject, domainCode, skillCode])
  @@index([ownerId, status, updatedAt])
}

model QuestionBankVersion {
  id            String                @id @default(uuid())
  questionId    String
  version       Int
  blocks        Json
  questionText  String
  choices       Json
  correctAnswer String
  explanation   String?
  createdById   Int
  createdAt     DateTime              @default(now())
  question      QuestionBankItem      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation("QuestionBankVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  snapshots     Question[]            @relation("QuestionBankVersionSnapshots")
  attempts      BankQuestionAttempt[]

  @@unique([questionId, version])
  @@index([questionId, createdAt])
}

model StudentBankQuestionProgress {
  userId         Int
  questionId     String
  attemptCount   Int              @default(0)
  correctCount   Int              @default(0)
  bestCorrect    Boolean          @default(false)
  lastCorrect    Boolean?
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, lastAttemptAt])
}

model Roadmap {
  id          String             @id @default(uuid())
  title       String
  description String?
  status      RoadmapStatus      @default(DRAFT)
  createdById Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   User               @relation("RoadmapCreator", fields: [createdById], references: [id], onDelete: Restrict)
  milestones  RoadmapMilestone[]

  @@index([status, updatedAt])
}

model RoadmapMilestone {
  id                    String                     @id @default(uuid())
  roadmapId             String
  title                 String
  description           String?
  order                 Int
  theoryBlocks          Json
  requiredQuestionCount Int                        @default(1)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  roadmap               Roadmap                    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skills                MilestoneSkill[]
  progress              StudentMilestoneProgress[]
  attempts              BankQuestionAttempt[]

  @@unique([roadmapId, order])
  @@index([roadmapId, order])
}

model MilestoneSkill {
  milestoneId String
  skillCode   String
  milestone   RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  skill       QuestionSkill    @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([milestoneId, skillCode])
  @@index([skillCode])
}

model StudentMilestoneProgress {
  userId            Int
  milestoneId       String
  theoryConfirmedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone         RoadmapMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([userId, milestoneId])
  @@index([userId, completedAt])
}

model BankQuestionAttempt {
  id             String              @id @default(uuid())
  userId         Int
  questionId     String
  versionId      String
  milestoneId    String?
  selectedChoice String?
  isCorrect      Boolean
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       QuestionBankItem    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version        QuestionBankVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  milestone      RoadmapMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId, questionId, createdAt])
  @@index([userId, milestoneId, createdAt])
}

model Submission {
  id                     Int                 @id @default(autoincrement())
  userId                 Int
  testId                 Int
  assignmentId           String?
  assignment             Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classTestId            Int?
  classTest              ClassTest?          @relation(fields: [classTestId], references: [id], onDelete: Cascade)
  deliveryId             String?
  delivery               TestDelivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  attemptNo              Int                 @default(1)
  attemptMode            TestMode            @default(PRACTICE)
  timingPreset           AttemptTimingPreset @default(STANDARD)
  allowedDurationSeconds Int?
  moduleTimingSnapshot   Json?
  questionTimingSnapshot Json?
  endTime                DateTime?
  score                  Int?
  violationCount         Int                 @default(0)
  startedAt              DateTime            @default(now())
  beganAt                DateTime?
  currentModule          Int                 @default(1)
  moduleStartedAt        DateTime?
  moduleExpiresAt        DateTime?
  currentQuestionIndex   Int                 @default(0)
  savedAnswers           Json?
  timeRemaining          Int?
  status                 SubmissionStatus    @default(DOING)
  answers                Answer[]
  test                   Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  user                   User                @relation(fields: [userId], references: [id])
  questionTimings        QuestionTiming[]
  errorLogs              ErrorLog[]

  @@unique([deliveryId, userId, attemptNo])
  @@index([deliveryId, status])
  @@index([userId, startedAt])
  @@index([userId, status, startedAt, id])
  @@index([testId, status])
}

model Answer {
  id             Int        @id @default(autoincrement())
  submissionId   Int
  questionId     Int
  selectedChoice String?
  isCorrect      Boolean    @default(false)
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model ErrorLog {
  id               String             @id @default(uuid())
  origin           ErrorLogOrigin     @default(MANUAL)
  source           String?
  sourceUrl        String?
  category         String?
  searchText       String?
  userAnswer       String?
  correctAnswer    String?
  questionSnapshot Json?
  whyChosen        String?
  whyWrong         String?
  whyRight         String?
  takeaway         String?
  rootCause        ErrorLogRootCause?
  reviewedAt       DateTime?
  version          Int                @default(1)
  clientMutationId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  userId           Int
  submissionId     Int?
  questionId       Int?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission       Submission?        @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  question         Question?          @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@unique([userId, submissionId, questionId])
  @@unique([userId, clientMutationId])
  @@index([userId, createdAt, id])
  @@index([userId, reviewedAt, createdAt, id])
  @@index([userId, category, createdAt, id])
}

model StudySession {
  id                String             @id @default(uuid())
  userId            Int
  status            StudySessionStatus @default(RUNNING)
  source            StudySessionSource @default(FOCUS_CLOCK)
  activityType      StudyActivityType  @default(OTHER)
  resourceType      StudyResourceType?
  resourceId        String?
  label             String?
  plannedDurationMs Int
  accumulatedMs     Int                @default(0)
  startedAt         DateTime           @default(now())
  lastResumedAt     DateTime?
  endedAt           DateTime?
  version           Int                @default(1)
  clientMutationId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientMutationId])
  @@index([userId, status, startedAt])
  @@index([userId, endedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    Int // ID của người nhận thông báo (Giáo viên hoặc Học sinh)
  message   String // Nội dung chi tiết
  link      String? // (Tùy chọn) Link để click vào thông báo bay đến trang tương ứng
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserTodoState {
  userId      Int
  itemKey     String
  handledAt   DateTime?
  completedAt DateTime?
  position    Int?
  plannedDate String?   @db.VarChar(10)
  plannedStartMinutes Int?
  plannedEndMinutes   Int?
  calendarColor       String? @db.VarChar(12)
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemKey])
  @@index([userId, handledAt])
  @@index([userId, position])
}

model StudentTask {
  id          String    @id @default(uuid())
  userId      Int
  title       String
  details     String?
  dueAt       DateTime?
  completedAt DateTime?
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt, dueAt])
  @@index([userId, position])
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum TestMode {
  PRACTICE
  EXAM
}

enum AttemptTimingPreset {
  STANDARD
  HALF_TIME
  EXTENDED_50
  EXTENDED_100
  CUSTOM
  UNTIMED
}

enum TestCategory {
  REAL
  CLASS
  PRACTICE
}

enum TestSubject {
  RW
  MATH
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestScope {
  SYSTEM
  PERSONAL
}

enum SubmissionStatus {
  DOING
  COMPLETED
}

enum StudySessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum StudySessionSource {
  FOCUS_CLOCK
  TEST
  VOCABULARY
  HOMEWORK
}

enum StudyActivityType {
  PRACTICE
  VOCABULARY
  ERROR_LOG
  HOMEWORK
  OTHER
}

enum StudyResourceType {
  TEST
  VOCABULARY_SET
  ASSIGNMENT
}

enum SubmissionContentSlot {
  DRAFT
  SUBMITTED
}

enum SubmissionItemKind {
  FILE
  LINK
}

enum FileAssetStatus {
  PENDING_UPLOAD
  READY
  PENDING_DELETE
}

enum FileAssetPurpose {
  GENERAL
  TEST_IMAGE
  FEEDBACK_IMAGE
}

enum DeliveryStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ScorePolicy {
  FIRST
  BEST
  LATEST
}

enum QuestionType {
  MCQ // Trắc nghiệm
  SPR // Tự luận điền số (Grid-in)
}

enum QuestionBankScope {
  SYSTEM
  PERSONAL
}

enum QuestionBankStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionBankDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RoadmapStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ErrorLogOrigin {
  SYSTEM_QUESTION
  MANUAL
}

enum ErrorLogRootCause {
  KNOWLEDGE_GAP
  MISREAD_QUESTION
  MISREAD_PASSAGE
  WRONG_REASONING
  CARELESS_MISTAKE
  TIME_PRESSURE
  CALCULATION_ERROR
  GUESSED
}

enum VocabularySetScope {
  SYSTEM
  PERSONAL
}

enum VocabularySetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VocabularyMastery {
  NOT_STUDIED
  LEARNING
  MASTERED
}

enum VocabularyStudyMode {
  FLASHCARD
  QUIZ
}

enum VocabularySessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum ClassActivityType {
  TEST
  QUIZ
  VOCABULARY
  HOMEWORK
  RESOURCE
}

enum ActivityCompletionRule {
  VIEW_ALL
  SUBMIT
  SCORE_AT_LEAST
  MANUAL
}

enum ActivityAudience {
  ALL_STUDENTS
  SELECTED
}

enum ActivityAssigneeStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  MISSING
  EXCUSED
}

enum LearningFollowUpSource {
  SKILL_SIGNAL
  STUDENT_CHECK_IN
  ASSESSMENT
  MANUAL
}

enum LearningFollowUpAction {
  TEST
  HOMEWORK
  CHECK_IN
}

enum LearningFollowUpStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  READY_TO_EVALUATE
  RESOLVED
  NEEDS_FOLLOW_UP
  DISMISSED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CourseContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LessonResourceKind {
  FILE
  VIDEO
  LINK
  EMBED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonBlockKind {
  TEXT
  RESOURCE
  ACTIVITY
}

enum LessonBlockPhase {
  BEFORE_CLASS
  DURING_CLASS
  AFTER_CLASS
}

model Week {
  id          String              @id @default(uuid())
  title       String
  description String?
  order       Int                 @default(0)
  isExpanded  Boolean             @default(true)
  status      CourseContentStatus @default(DRAFT)
  availableAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  classId     String
  class       Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([classId, status, order])
}

model Lesson {
  id              String              @id @default(uuid())
  title           String
  summary         String?
  order           Int                 @default(0)
  status          CourseContentStatus @default(DRAFT)
  scheduledAt     DateTime?
  durationMinutes Int?
  availableAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  weekId          String
  week            Week                @relation(fields: [weekId], references: [id], onDelete: Cascade)
  files           LessonFile[]
  assignments     LessonAssignment[]
  deliveries      TestDelivery[]
  activities      ClassActivity[]
  progress        LessonProgress[]
  attendance      AttendanceSession?
  blocks          LessonBlock[]

  @@index([weekId, status, order])
}

model LessonBlock {
  id         String                @id @default(uuid())
  lessonId   String
  kind       LessonBlockKind
  phase      LessonBlockPhase      @default(DURING_CLASS)
  order      Int                   @default(0)
  title      String?
  body       String?
  isRequired Boolean               @default(true)
  resourceId String?               @unique
  activityId String?               @unique
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  lesson     Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resource   LessonFile?           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  activity   ClassActivity?        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  progress   LessonBlockProgress[]

  @@index([lessonId, phase, order])
}

model LessonBlockProgress {
  blockId      String
  studentId    Int
  openedAt     DateTime    @default(now())
  lastOpenedAt DateTime    @default(now()) @updatedAt
  completedAt  DateTime?
  block        LessonBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  student      User        @relation("LessonBlockProgressStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([blockId, studentId])
  @@index([studentId, completedAt])
}

model AttendanceSession {
  id           String             @id @default(uuid())
  lessonId     String             @unique
  recordedById Int
  recordedAt   DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  recordedBy   User               @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  records      AttendanceRecord[]

  @@index([recordedById, recordedAt])
}

model AttendanceRecord {
  attendanceSessionId String
  studentId           Int
  status              AttendanceStatus
  note                String?
  recordedAt          DateTime          @default(now())
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student             User              @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([attendanceSessionId, studentId])
  @@index([studentId, status])
}

model TestDelivery {
  id                       String             @id @default(uuid())
  classId                  String
  testId                   Int
  lessonId                 String?
  title                    String
  availableAt              DateTime?
  dueAt                    DateTime?
  maxAttempts              Int                @default(1)
  scorePolicy              ScorePolicy        @default(FIRST)
  status                   DeliveryStatus     @default(PUBLISHED)
  createdAt                DateTime           @default(now())
  createdById              Int
  legacyClassTestId        Int?               @unique
  sourceAssignmentId       String?
  sourceLessonAssignmentId String?
  class                    Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  test                     Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  lesson                   Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy                User               @relation("DeliveryCreator", fields: [createdById], references: [id])
  assignees                DeliveryAssignee[]
  submissions              Submission[]
  activity                 TestActivity?

  @@index([classId, dueAt])
  @@index([testId])
  @@index([sourceAssignmentId, testId])
  @@index([sourceLessonAssignmentId, testId])
}

model DeliveryAssignee {
  deliveryId String
  studentId  Int
  assignedAt DateTime     @default(now())
  excusedAt  DateTime?
  delivery   TestDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  student    User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([deliveryId, studentId])
  @@index([studentId])
}

model QuestionTiming {
  id               Int        @id @default(autoincrement())
  submissionId     Int
  questionId       Int
  activeDurationMs Int
  visitCount       Int        @default(1)
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question         Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model LessonFile {
  id              String             @id @default(uuid())
  name            String
  url             String
  kind            LessonResourceKind @default(FILE)
  provider        String?
  mimeType        String?
  thumbnailUrl    String?
  durationSeconds Int?
  order           Int                @default(0)
  isRequired      Boolean            @default(false)
  availableAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lessonId        String
  fileAssetId     String?            @unique
  lesson          Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileAsset       FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  progress        ResourceProgress[]
  block           LessonBlock?

  @@index([lessonId, order])
}

model LessonAssignment {
  id           String      @id @default(uuid())
  title        String
  content      String?
  dueDate      DateTime?
  testIds      Int[]       @default([])
  createdAt    DateTime    @default(now())
  lessonId     String      @unique
  assignmentId String?     @unique
  lesson       Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  lessonId     String
  studentId    Int
  status       LessonProgressStatus @default(NOT_STARTED)
  progress     Int                  @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  lastOpenedAt DateTime?
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lessonId, studentId])
  @@index([studentId, status])
}

model ResourceProgress {
  fileId          String
  studentId       Int
  openedAt        DateTime   @default(now())
  lastOpenedAt    DateTime   @default(now())
  completedAt     DateTime?
  positionSeconds Int        @default(0)
  file            LessonFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  student         User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([fileId, studentId])
  @@index([studentId, completedAt])
}

model VocabularySet {
  id                  String                   @id @default(uuid())
  title               String
  description         String?
  scope               VocabularySetScope
  status              VocabularySetStatus      @default(DRAFT)
  sourceLanguage      String                   @default("en")
  translationLanguage String                   @default("vi")
  version             Int                      @default(1)
  ownerId             Int?
  autoKey             String?                  @db.VarChar(40)
  createdById         Int
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  publishedAt         DateTime?
  owner               User?                    @relation("VocabularySetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy           User                     @relation("VocabularySetCreator", fields: [createdById], references: [id])
  terms               VocabularyTerm[]
  sessions            VocabularyStudySession[]
  activities          VocabularyActivity[]

  @@index([scope, status, publishedAt])
  @@index([ownerId, updatedAt])
  @@unique([ownerId, autoKey])
}

model VocabularyTerm {
  id               String                      @id @default(uuid())
  setId            String
  word             String
  normalizedWord   String
  meaning          String
  translation      String
  exampleSentence  String?
  dictionaryDefinition Boolean                 @default(false)
  order            Int
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  set              VocabularySet               @relation(fields: [setId], references: [id], onDelete: Cascade)
  progress         VocabularyTermProgress[]
  sessionQuestions VocabularySessionQuestion[]
  activityItems    VocabularyActivityItem[]

  @@unique([setId, normalizedWord])
  @@unique([setId, order])
  @@index([normalizedWord])
}

model VocabularyTermProgress {
  userId         Int
  termId         String
  mastery        VocabularyMastery @default(NOT_STUDIED)
  seenCount      Int               @default(0)
  correctCount   Int               @default(0)
  incorrectCount Int               @default(0)
  correctStreak  Int               @default(0)
  lastReviewedAt DateTime?
  dueAt          DateTime?
  fsrsStability  Float             @default(0)
  fsrsDifficulty Float             @default(0)
  fsrsState      Int               @default(0)
  fsrsReps       Int               @default(0)
  fsrsLapses     Int               @default(0)
  fsrsLearningSteps Int            @default(0)
  fsrsScheduledDays Int            @default(0)
  fsrsElapsedDays Int              @default(0)
  fsrsLastReview DateTime?
  reviewLogs     VocabularyReviewLog[]
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  term           VocabularyTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([userId, termId])
  @@index([userId, mastery])
  @@index([userId, dueAt])
}

model VocabularyReviewLog {
  id            String                  @id @default(uuid())
  userId        Int
  termId        String
  questionId    String?                 @unique
  rating        Int
  reviewedAt    DateTime
  nextDueAt     DateTime
  previousState Json
  nextState     Json
  progress      VocabularyTermProgress @relation(fields: [userId, termId], references: [userId, termId], onDelete: Cascade)
  question      VocabularySessionQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([userId, reviewedAt])
  @@index([userId, termId, reviewedAt])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  action       String
  targetUserId Int?
  targetEmail  String
  environment  String
  actor        String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([targetEmail, createdAt])
  @@index([action, createdAt])
}

model AuditEvent {
  id          String   @id @default(uuid())
  action      String
  category    String
  actorUserId Int?
  actorLabel  String
  actorRole   Role?
  entityType  String
  entityId    String?
  entityLabel String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([action, createdAt])
  @@index([category, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model ClassActivity {
  id                 String                   @id @default(uuid())
  type               ClassActivityType
  status             DeliveryStatus           @default(DRAFT)
  classId            String
  lessonId           String?
  title              String
  instructions       String?
  availableAt        DateTime?
  dueAt              DateTime?
  maxAttempts        Int                      @default(1)
  scorePolicy        ScorePolicy              @default(FIRST)
  completionRule     ActivityCompletionRule   @default(SUBMIT)
  passingScore       Int?
  audience           ActivityAudience         @default(ALL_STUDENTS)
  createdById        Int
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  class              Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson             Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy          User                     @relation("ActivityCreator", fields: [createdById], references: [id])
  assignees          ActivityAssignee[]
  vocabulary         VocabularyActivity?
  test               TestActivity?
  homework           HomeworkActivity?
  vocabularySessions VocabularyStudySession[]
  followUpId         String?
  followUp           LearningFollowUp?        @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  lessonBlock        LessonBlock?

  @@index([classId, status, dueAt])
  @@index([classId, createdAt])
  @@index([lessonId])
  @@index([followUpId])
}

model LearningFollowUp {
  id                     String                   @id @default(uuid())
  classId                String
  createdById            Int
  sourceType             LearningFollowUpSource
  actionType             LearningFollowUpAction
  status                 LearningFollowUpStatus   @default(OPEN)
  subject                TestSubject?
  domainCode             String?
  domainName             String?
  skillCode              String?
  skillName              String?
  sourceDeliveryId       String?
  sourceStudentId        Int?
  reason                 String?
  baselineAccuracy       Int?
  baselineCorrect        Int?
  baselineAnswerCount    Int?
  baselineStudentCount   Int?
  classificationCoverage Int?
  resolutionNote         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  resolvedAt             DateTime?
  class                  Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy              User                     @relation("LearningFollowUpCreator", fields: [createdById], references: [id])
  targets                LearningFollowUpTarget[]
  activities             ClassActivity[]

  @@index([classId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([skillCode])
  @@index([sourceDeliveryId])
}

model LearningFollowUpTarget {
  followUpId          String
  studentId           Int
  baselineAccuracy    Int?
  baselineCorrect     Int?
  baselineAnswerCount Int?
  followUp            LearningFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  student             User             @relation("LearningFollowUpTargetStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([followUpId, studentId])
  @@index([studentId])
}

model TestActivity {
  activityId     String        @id
  testDeliveryId String        @unique
  activity       ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  testDelivery   TestDelivery  @relation(fields: [testDeliveryId], references: [id], onDelete: Cascade)
}

model HomeworkActivity {
  activityId   String        @id
  assignmentId String        @unique
  activity     ClassActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model ActivityAssignee {
  activityId   String
  studentId    Int
  status       ActivityAssigneeStatus @default(ASSIGNED)
  assignedAt   DateTime               @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  bestScore    Int?
  attemptCount Int                    @default(0)
  excusedAt    DateTime?
  activity     ClassActivity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student      User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([activityId, studentId])
  @@index([studentId, status])
}

model VocabularyActivity {
  activityId       String                   @id
  vocabularySetId  String
  sourceSetVersion Int
  questionCount    Int?
  activity         ClassActivity            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  vocabularySet    VocabularySet            @relation(fields: [vocabularySetId], references: [id])
  items            VocabularyActivityItem[]
}

model VocabularyActivityItem {
  id              String             @id @default(uuid())
  activityId      String
  sourceTermId    String?
  word            String
  meaning         String
  translation     String
  exampleSentence String?
  dictionaryDefinition Boolean       @default(false)
  order           Int
  activity        VocabularyActivity @relation(fields: [activityId], references: [activityId], onDelete: Cascade)
  sourceTerm      VocabularyTerm?    @relation(fields: [sourceTermId], references: [id], onDelete: SetNull)

  @@unique([activityId, order])
  @@index([sourceTermId])
}

model VocabularyStudySession {
  id             String                      @id @default(uuid())
  userId         Int
  setId          String?
  isDaily        Boolean                     @default(false)
  activityId     String?
  mode           VocabularyStudyMode
  status         VocabularySessionStatus     @default(IN_PROGRESS)
  totalItems     Int
  correctCount   Int                         @default(0)
  rangeStart     Int?
  rangeEnd       Int?
  shuffle        Boolean                     @default(false)
  startedAt      DateTime                    @default(now())
  lastActivityAt DateTime                    @default(now())
  completedAt    DateTime?
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  set            VocabularySet?              @relation(fields: [setId], references: [id], onDelete: Cascade)
  activity       ClassActivity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  questions      VocabularySessionQuestion[]

  @@index([userId, status, startedAt])
  @@index([userId, setId, mode, status, lastActivityAt])
  @@index([userId, isDaily, status, lastActivityAt], map: "VocabularyStudySession_daily_active_idx")
  @@index([activityId, userId])
}

model VocabularySessionQuestion {
  id              String                 @id @default(uuid())
  sessionId       String
  sourceTermId    String?
  prompt          String
  correctMeaning  String
  translation     String
  exampleSentence String?
  dictionaryDefinition Boolean          @default(false)
  options         Json
  order           Int
  sourceOrder     Int?
  selectedMeaning String?
  isCorrect       Boolean?
  answeredAt      DateTime?
  session         VocabularyStudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceTerm      VocabularyTerm?        @relation(fields: [sourceTermId], references: [id], onDelete: SetNull)
  reviewLog       VocabularyReviewLog?

  @@unique([sessionId, order])
  @@index([sourceTermId])
}
