VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_DRIVE_API_KEY=your-google-api-key
VITE_DRIVE_APP_ID=your-google-cloud-project-number
VITE_DESMOS_API=your-desmos-api-key

# Optional monitoring. VITE_* values are bundled into the browser and are not secrets.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
